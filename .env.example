# ⚠️  SECURITY NOTICE
# The Firebase private key was exposed in a local .env file (not committed to git).
# Rotate FIREBASE_PRIVATE_KEY in the Firebase Console before deploying to production:
#   Firebase Console → Project Settings → Service accounts → Generate new private key

# Database
DATABASE_URL=postgresql://user:password@host:5432/monitor_agent

# Anthropic (Claude agent)
ANTHROPIC_API_KEY=sk-ant-...

# Vercel (redeploy + logs)
VERCEL_TOKEN=...

# Firebase Admin (reads hub_clients for dynamic client list)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=default   # la base del producto es la nombrada "default" (requerida en producción)

# Notifications — email
RESEND_API_KEY=
NOTIFY_EMAIL=liam.arzac@gmail.com
FROM_EMAIL=Nichos Monitor <noreply@arzac.studio>
# MONITOR_PROBE_URL=https://no-existe.arzac.studio   # sonda de prueba (P-04 G3); quitar al terminar

# Notifications — WhatsApp (Twilio, critical incidents only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP=whatsapp:+9720557719141

# Server
PORT=8080

# Agent controls
MONITOR_AGENT_MODEL=claude-haiku-4-5-20251001
MONITOR_AGENT_ENABLED=false   # apagado por defecto (P-04 D-P4-4); true enciende el agente IA + vercelRedeploy
MONITOR_AGENT_MAX_PER_HOUR=10
MONITOR_CONCURRENCY=10
